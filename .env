# WhatsApp Dragon Race to the Edge - Bot Configuration

# === Bot Owner ===
# The owner has full access to all bot commands and settings
BOT_OWNER_NUMBER=267712568150
BOT_OWNER_NAME=Dragon Master

# === WhatsApp Session ===
# Leave empty initially - will be populated after first scan
SESSION_ID=

# === API Keys & Secrets ===
# Cloudinary (image generation and manipulation)
CLOUDINARY_CLOUD_NAME=your_cloudinary_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Giphy API (for GIF/animation fetching)
GIPHY_API_KEY=your_giphy_api_key

# Unsplash API (for dragon image searches)
UNSPLASH_ACCESS_KEY=your_unsplash_api_key

# === Game Configuration ===
# Card system costs
CARD_CLAIM_COST=100
CARD_PACK_COST=300
CARD_PACK_SIZE=3

# Guild system
GUILD_CREATE_COST=10000

# === Server Configuration ===
PORT=5000
NODE_ENV=production

# === Bot Settings ===
BOT_MODE=public
AUTO_TYPING=false
AUTO_READ=false
ANTIDELETE_ENABLED=false
AUTOREACT_ENABLED=false
WILD_SPAWNS_ENABLED=true
PREFIX=%

# === Feature Flags ===
ENABLE_DRAGON_RACING=true
ENABLE_DUNGEON_MODE=true
ENABLE_CATCH_SYSTEM=true
ENABLE_PVP_BATTLES=true
ENABLE_GUILD_SYSTEM=true
